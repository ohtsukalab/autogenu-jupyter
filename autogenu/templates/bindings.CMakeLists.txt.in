macro(pybind11_add_cgmres_module MODULE)
  pybind11_add_module(${MODULE} MODULE ${MODULE}.cpp)
  target_include_directories(
    ${MODULE}
    PRIVATE
    ${CGMRES_INCLUDE_DIR}
    ${CGMRES_INCLUDE_DIR}/cgmres/thirdparty/eigen
    ${CGMRES_INCLUDE_DIR}/cgmres/thirdparty/pybind11
    ${PROJECT_SOURCE_DIR}
  )
  cgmres_enable_strict_warnings(${MODULE})
  cgmres_enable_sanitizers(${MODULE})
  if (MINGW)
    # Keep installed Python extension modules self-contained. Since Python
    # 3.8, Windows does not reliably search PATH for dependent extension DLLs.
    target_link_options(${MODULE} PRIVATE -static-libgcc -static-libstdc++)
  endif()
  if (VECTORIZE)
    target_compile_options(${MODULE} PRIVATE -march=native)
  endif()
endmacro()

set(PYBIND11_FINDPYTHON ON)
add_subdirectory(
  ${CGMRES_INCLUDE_DIR}/cgmres/thirdparty/pybind11
  ${CMAKE_CURRENT_BINARY_DIR}/thirdparty/pybind11
)
{{module_targets}}

file(GLOB PYTHON_BINDINGS_${CURRENT_MODULE_DIR} ${CMAKE_CURRENT_BINARY_DIR}/*.cpython*)
file(GLOB PYTHON_FILES_${CURRENT_MODULE_DIR} ${CMAKE_CURRENT_SOURCE_DIR}/*.py)
install(
  FILES ${PYTHON_FILES_${CURRENT_MODULE_DIR}} ${PYTHON_BINDINGS_${CURRENT_MODULE_DIR}}
  DESTINATION {{install_destination}}
)
